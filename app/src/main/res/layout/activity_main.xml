<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="top"
        android:layout_marginVertical="16dp"
        android:padding="16dp">

    <TextView
        android:id="@+id/stoper1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00:00.00"
        android:textSize="30sp"
        android:paddingBottom="16dp"/>

        <Button
            android:id="@+id/startStoper1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start"
            android:onClick="startStoper1"/>

        <Button
            android:id="@+id/stopStoper1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop"
            android:onClick="stopStoper1">
        </Button>

        <Button
            android:id="@+id/resetStoper1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:onClick="resetStoper1">
        </Button>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

    <Button
        android:id="@+id/buttonZmiana1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Przejdź do minutnika"
        android:onClick="onClickButton"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:padding="16dp">

        <TextView
            android:id="@+id/stoper2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00.00"
            android:textSize="30sp"
            android:paddingBottom="16dp"/>

        <Button
            android:id="@+id/startStoper2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start"
            android:onClick="startStoper2"/>

        <Button
            android:id="@+id/stopStoper2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop"
            android:onClick="stopStoper2">
        </Button>

        <Button
            android:id="@+id/resetStoper2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:onClick="resetStoper2">
        </Button>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
