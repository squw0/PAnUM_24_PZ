<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/maininne"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivitykolejne">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="30dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minutnik 1"
            ></TextView>

        <TextView
            android:id="@+id/minutnik1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00.00"
            android:textSize="30sp"
            android:paddingBottom="16dp"/>

        <Button
            android:id="@+id/rozpocznijMinutnik1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start"
            android:onClick="startMinutnik1">
        </Button>

        <Button
            android:id="@+id/zatrzymajMinutnik1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop"
            android:onClick="stopMinutnik1">
        </Button>

        <Button
            android:id="@+id/resetMinutnik1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:onClick="resetMinutnik1">
        </Button>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="40dp"
        android:gravity="center"
        android:orientation="horizontal">

    <Button
        android:id="@+id/buttonZmiana2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Przejdź do stopera"
        android:onClick="goToMain"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minutnik 2"
            ></TextView>

        <TextView
            android:id="@+id/minutnik2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00.00"
            android:textSize="30sp"
            android:paddingBottom="16dp"/>

        <Button
            android:id="@+id/rozpocznijMinutnik2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start"
            android:onClick="startMinutnik2">
        </Button>

        <Button
            android:id="@+id/zatrzymajMinutnik2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop"
            android:onClick="stopMinutnik2">
        </Button>

        <Button
            android:id="@+id/resetMinutnik2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:onClick="resetMinutnik2">
        </Button>
    </LinearLayout>
</LinearLayout>
